// LO division is total: x/0 = -1, x%0 = x, INT_MIN/-1 = INT_MIN, INT_MIN%-1 = 0.
// Expected stdout (one per line): -1 7 -2147483648 0 -3 -1 -715827882
// Expected exit status: 0

class Main () {
    int main() {
        int a; int b; int m; int n; int x;
        a = 7;
        b = 0;
        m = ((0 - 2147483647) - 1);
        n = (0 - 1);
        x = (0 - 7);
        out.print_int((a / b)); out.println();
        out.print_int((a % b)); out.println();
        out.print_int((m / n)); out.println();
        out.print_int((m % n)); out.println();
        out.print_int((x / 2)); out.println();
        out.print_int((x % 3)); out.println();
        out.print_int((m / 3)); out.println();
        return 0;
    }
}
