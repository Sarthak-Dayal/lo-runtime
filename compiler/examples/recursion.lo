// Recursion, branches and printing.
// Expected stdout: 120 then 610. Expected exit status: 120

class Main () {
    int fact(int n) {
        if ((n < 2)) { return 1; } else { return (n * this.fact((n - 1))); }
    }

    int fib(int n) {
        if ((n < 2)) { return n; } else { return (this.fib((n - 1)) + this.fib((n - 2))); }
    }

    int main() {
        out.print_int(this.fact(5));
        out.println();
        out.print_int(this.fib(15));
        out.println();
        return this.fact(5);
    }
}
