// Eight arguments: the last two are passed on the stack.
// Expected exit status: 246 (-10 modulo 256)

class Main () {
    int f(int a, int b, int c, int d, int e, int g, int h, int i) {
        return (((a - b) + ((c - d) * 2)) + (((e - g) * 3) + ((h - i) * 4)));
    }

    int main() {
        return this.f(1, 2, 3, 4, 5, 6, 7, 8);
    }
}
