// main method return value: 234
// P10/P22/P23/P49: evaluate the computed receiver before left-to-right actuals.
class Box(int base;) {
    int sum(int a, int b) { return ((base + a) + b); }
}
class Counter(int stamp;) {
    Box receiver() { stamp = ((stamp * 10) + 1); return new Box(100); }
    int argument() { stamp = ((stamp * 10) + 2); return stamp; }
}
class Main() {
    int main() {
        Counter counter;
        counter = new Counter(0);
        return (counter.receiver()).sum(counter.argument(), counter.argument());
    }
}
