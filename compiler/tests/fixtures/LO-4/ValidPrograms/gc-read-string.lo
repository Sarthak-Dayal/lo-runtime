// main method return value: 42
// P7/P17/P23: an I/O reference return remains rooted across moving GC.
class Garbage() {}
class Main() {
    int main() {
        String text;
        Garbage junk;
        int i;
        text = in.read_string();
        while ((i < 1200000)) {
            junk = new Garbage();
            i = (i + 1);
        }
        out.print_string(text);
        out.println();
        return 42;
    }
}
